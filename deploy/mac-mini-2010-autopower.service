# Mac mini 2010 (NVIDIA chipset): power back on after a power cut.
# The chipset forgets this at every boot, so this unit sets it again each time.
# Check first that `lspci -s 00:03.0` names the NVIDIA ISA/LPC bridge. Other Mac models use a different register.
[Unit]
Description=Power on after power failure (Mac mini 2010)

[Service]
Type=oneshot
ExecStart=/usr/bin/setpci -s 00:03.0 0x7b.b=0x19

[Install]
WantedBy=multi-user.target
